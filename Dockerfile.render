# Render build for the Govrly/Probo fork. Builds from source in three stages,
# following upstream's release workflow (.github/workflows/release-probod.yaml).

# Stage 1: frontend assets (console, compliance portal, employee portal, emails)
FROM node:24-bookworm-slim AS frontend
RUN npm install -g npm@^12.0.2
WORKDIR /app
COPY . .
RUN npm ci
RUN sh contrib/merge-graphql-schema.sh pkg/server/api/connect/v1/schema.graphql          pkg/server/api/connect/v1/graphql \
 && sh contrib/merge-graphql-schema.sh pkg/server/api/console/v1/schema.graphql          pkg/server/api/console/v1/graphql \
 && sh contrib/merge-graphql-schema.sh pkg/server/api/complianceportal/v1/schema.graphql pkg/server/api/complianceportal/v1/graphql
RUN npm --workspace @probo/emails run build
RUN npm run relay
ENV NODE_ENV=production
RUN npm --workspace @probo/console run build \
 && npm --workspace @probo/compliance-portal run build \
 && npm --workspace @probo/employee-portal run build

# Stage 2: Go binaries
FROM golang:1.27-alpine AS backend
RUN apk add --no-cache git
ENV GOTOOLCHAIN=auto
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /app/apps/console/dist           apps/console/dist
COPY --from=frontend /app/apps/compliance-portal/dist apps/compliance-portal/dist
COPY --from=frontend /app/apps/employee-portal/dist   apps/employee-portal/dist
COPY --from=frontend /app/packages/emails/dist        packages/emails/dist
RUN go generate ./pkg/server/api/connect/v1 \
 && go generate ./pkg/server/api/mcp/v1 \
 && go generate ./pkg/server/api/console/v1 \
 && go generate ./pkg/server/api/complianceportal/v1
RUN VERSION="$(cat cmd/probod/VERSION)" \
 && BOOTSTRAP_VERSION="$(cat cmd/probod-bootstrap/VERSION)" \
 && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
      -ldflags="-w -s -X 'main.version=${VERSION}' -X 'main.env=prod'" \
      -o /probod ./cmd/probod \
 && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
      -ldflags="-w -s -X 'main.version=${BOOTSTRAP_VERSION}'" \
      -o /probod-bootstrap ./cmd/probod-bootstrap

# Stage 3: runtime. Alpine, binaries under /app owned by the runtime user:
# Render's no-new-privileges policy breaks the upstream Ubuntu + setcap image.
FROM alpine:latest
RUN apk --no-cache add ca-certificates openssl bash && \
    addgroup -g 1000 probo && \
    adduser -D -u 1000 -G probo probo && \
    mkdir -p /etc/probod && \
    chown probo:probo /etc/probod
ENV PATH="/app:${PATH}"
WORKDIR /app
COPY --from=backend --chown=probo:probo /probod ./probod
COPY --from=backend --chown=probo:probo /probod-bootstrap ./probod-bootstrap
COPY --chown=probo:probo entrypoint.sh ./entrypoint.sh
COPY --chown=probo:probo rds-ca-bundle.pem ./rds-ca-bundle.pem
USER probo
EXPOSE 8080
CMD ["bash", "./entrypoint.sh"]
